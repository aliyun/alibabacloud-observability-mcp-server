# ============================================================
# Alibaba Cloud Observability MCP Server — Environment Variables
# ============================================================
# Copy this file:  cp .env.example .env
# Then fill in your credentials.

# ── Alibaba Cloud Credentials (Required*) ─────────────────────
# Get your AccessKey at: https://ram.console.aliyun.com/manage/ak
#
# * When left empty, the server falls back to the Alibaba Cloud
#   default credential chain (ECS RAM Role, OIDC, credentials file).
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ── STS Temporary Token (Optional) ───────────────────────────
# Only needed when using STS temporary credentials.
# ALIBABA_CLOUD_SECURITY_TOKEN=

# ── Default Region (Optional) ────────────────────────────────
# Fallback region for tool calls that omit regionId.
ALIBABA_CLOUD_REGION=cn-hangzhou

# ── Default Workspace (Optional) ─────────────────────────────
# Needed for PaaS tools (umodel_*) when the caller omits workspace.
# ALIBABA_CLOUD_WORKSPACE=
